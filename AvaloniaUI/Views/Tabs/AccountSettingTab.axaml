<v:AccountSettingTabBase
    x:Class="AvaloniaUI.Views.Tabs.AccountSettingTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.Tabs"
    xmlns:uc="using:AvaloniaUI.Views.UserControls">
    <Grid Classes="page" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="10" ColumnDefinitions="4*,*,*">
            <Button x:Name="SaveButton"   Grid.Column="0" Content="Save"   ToolTip.Tip="Save" Classes="primary" />
            <Button x:Name="ImportButton" Grid.Column="1" Content="Import" ToolTip.Tip="Import" Margin="5,0,0,0" />
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export" ToolTip.Tip="Export" Margin="5,0,0,0" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Account information" />
                        <uc:TribeSelectorUc x:Name="Tribes" Text="Tribe" />
                    </StackPanel>
                </Border>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Activity settings" />
                        <uc:RangeInputUc x:Name="WorkTime"  Text="Work time"  Unit="minutes" />
                        <uc:RangeInputUc x:Name="SleepTime" Text="Sleep time" Unit="minutes" />
                    </StackPanel>
                </Border>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Delay settings" />
                        <uc:RangeInputUc x:Name="ClickDelay" Text="Click delay" Unit="milliseconds" />
                        <uc:RangeInputUc x:Name="TaskDelay"  Text="Task delay"  Unit="milliseconds" />
                    </StackPanel>
                </Border>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Feature settings" />
                        <CheckBox x:Name="EnableAutoLoadVillage"    Content="Enable auto load village's building" />
                        <CheckBox x:Name="EnableAutoStartAdventure" Content="Enable auto start adventure" />
                    </StackPanel>
                </Border>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Hero settings" />
                        <CheckBox x:Name="EnableAutoAssignHeroPoints" Content="Enable auto assign hero points" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                            <Label Content="Points per level (total 4)" VerticalAlignment="Center" />
                            <TextBox x:Name="HeroPointsFightingStrength" Watermark="Fighting strength" UseFloatingWatermark="True" Width="130" />
                            <TextBox x:Name="HeroPointsOffBonus"         Watermark="Offence bonus"     UseFloatingWatermark="True" Width="130" />
                            <TextBox x:Name="HeroPointsDefBonus"         Watermark="Defence bonus"     UseFloatingWatermark="True" Width="130" />
                            <TextBox x:Name="HeroPointsResources"        Watermark="Resources"         UseFloatingWatermark="True" Width="130" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="box">
                    <StackPanel>
                        <TextBlock Classes="header" Text="Chrome settings" />
                        <CheckBox x:Name="HeadlessChrome" Content="Use headless chrome" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</v:AccountSettingTabBase>
