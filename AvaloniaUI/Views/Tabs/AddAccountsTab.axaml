<v:AddAccountsTabBase
    x:Class="AvaloniaUI.Views.Tabs.AddAccountsTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.Tabs">
    <Grid Classes="page" RowDefinitions="Auto,*,*,Auto">
        <Border Classes="box">
            <TextBox IsReadOnly="True" Margin="5,0,5,0"
                     Text="Format: https://serverl.url username password [proxy_host] [proxy_port] [proxy_username] [proxy_password]" />
        </Border>
        <Border Classes="box" Grid.Row="1">
            <TextBox x:Name="AccountsInput" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Visible" Margin="5,0,5,0" />
        </Border>
        <Border Classes="box" Grid.Row="2">
            <DataGrid x:Name="AccountsView" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server"           Binding="{Binding Server}" />
                    <DataGridTextColumn Header="Username"         Binding="{Binding Username}" />
                    <DataGridTextColumn Header="Password"         Binding="{Binding Password}" />
                    <DataGridTextColumn Header="Proxy's host"     Binding="{Binding ProxyHost}" />
                    <DataGridTextColumn Header="Proxy's port"     Binding="{Binding ProxyPort}" />
                    <DataGridTextColumn Header="Proxy's username" Binding="{Binding ProxyUsername}" />
                    <DataGridTextColumn Header="Proxy's password" Binding="{Binding ProxyPassword}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button x:Name="AddButton" Content="Add accounts" Grid.Row="3" Margin="10" Classes="primary" />
    </Grid>
</v:AddAccountsTabBase>
