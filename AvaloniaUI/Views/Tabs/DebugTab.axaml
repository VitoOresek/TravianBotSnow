<v:DebugTabBase
    x:Class="AvaloniaUI.Views.Tabs.DebugTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.Tabs">
    <Grid Classes="page" RowDefinitions="*,Auto">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*">
            <Button x:Name="ReportButton" Grid.Row="0" Grid.Column="0" Content="Buy a Coffee for Vinaghost" Margin="10" />
            <Button x:Name="LogButton"    Grid.Row="0" Grid.Column="1" Content="Open log folder"            Margin="10" />

            <Label Grid.Row="1" Grid.Column="0" Content="Task table"   HorizontalAlignment="Center" />
            <Label Grid.Row="1" Grid.Column="1" Content="Log messages" HorizontalAlignment="Center" />
            <Border Classes="box" Grid.Row="2" Grid.Column="0">
                <DataGrid x:Name="TaskView" IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task"       Binding="{Binding Task}" />
                        <DataGridTextColumn Header="Execute at" Binding="{Binding ExecuteAt}" />
                        <DataGridTextColumn Header="Stage"      Binding="{Binding Stage}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Classes="box" Grid.Row="2" Grid.Column="1">
                <TextBox x:Name="LogView" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         FontFamily="monospace" FontSize="12" />
            </Border>
        </Grid>

        <TextBox x:Name="DevToolsEndpointAddress" Grid.Row="1" Watermark="Devtools endpoint address" UseFloatingWatermark="True" Margin="5" IsReadOnly="True" />
    </Grid>
</v:DebugTabBase>
