<v:NoAccountTabBase
    x:Class="AvaloniaUI.Views.Tabs.NoAccountTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.Tabs">
    <Grid Classes="page">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Click account on the left side, if no account, use Add account or Add accounts button to add account" />
    </Grid>
</v:NoAccountTabBase>
