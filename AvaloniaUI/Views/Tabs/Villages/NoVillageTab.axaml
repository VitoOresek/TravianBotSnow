<v:NoVillageTabBase
    x:Class="AvaloniaUI.Views.Tabs.Villages.NoVillageTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.Tabs.Villages">
    <Grid Classes="page">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Click village on the left side, if no village, login to let bot update village list" />
    </Grid>
</v:NoVillageTabBase>
