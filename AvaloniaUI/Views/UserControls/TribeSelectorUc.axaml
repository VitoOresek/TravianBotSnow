<v:TribeSelectorUcBase
    x:Class="AvaloniaUI.Views.UserControls.TribeSelectorUc"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:AvaloniaUI.Views.UserControls"
    xmlns:converter="using:AvaloniaUI.Converter"
    x:Name="root">
    <v:TribeSelectorUcBase.Resources>
        <converter:TribeItemToCroppedBitmap x:Key="TribeItemConverter" />
    </v:TribeSelectorUcBase.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="6" Margin="0,2,0,2">
        <Label Content="{Binding #root.Text}" VerticalAlignment="Center" />
        <ComboBox x:Name="TribeComboBox" MinWidth="150">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ., Converter={StaticResource TribeItemConverter}}" Width="16" Height="16" />
                        <TextBlock Text="{Binding Tribe}" Margin="5,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </StackPanel>
</v:TribeSelectorUcBase>
